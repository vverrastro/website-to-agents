# Copy to .env and fill in. Never commit .env.
# All values below are placeholders.

# --- Runtime mode -----------------------------------------------------------
APP_ENV=development            # development | production
LOCAL_NO_AUTH=true             # development only; the API refuses to start if true with APP_ENV=production

# --- Infrastructure (bound to 127.0.0.1 by docker-compose.yml) ---------------
POSTGRES_USER=wta
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=wta
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://wta:change-me-local-only@127.0.0.1:5432/wta
REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM provider (server-side only) -----------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5      # blank = built-in default
LLM_EFFORT=                    # blank = model default; low|medium|high|xhigh|max
LLM_REFUSAL_FALLBACK=true      # Anthropic server-side refusal fallback
ANTHROPIC_API_KEY=

# --- Embedding provider (server-side only) -----------------------------------
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_CORS_ORIGINS=            # normally empty: dashboard uses a same-origin proxy
PUBLIC_MAX_BODY_BYTES=16384
PUBLIC_RATE_LIMIT_PER_MINUTE=20
PUBLIC_MAX_CONCURRENT_REQUESTS=8
PUBLIC_DAILY_QUOTA_PER_AGENT=2000
PUBLIC_REQUEST_TIMEOUT_SECONDS=45
TRUSTED_PROXY_HOPS=0           # proxies in front of the API; X-Forwarded-For ignored when 0
CONVERSATION_RETENTION_DAYS=30   # 0 disables the daily purge
RETRIEVAL_TOP_K=6
RETRIEVAL_CONTEXT_CHARS=8000
HISTORY_TURNS=6

# --- Crawler ------------------------------------------------------------------
CRAWLER_USER_AGENT=WebsiteToAgentsBot/0.1
CRAWLER_RENDERING_ENABLED=false  # Playwright fallback; requires `playwright install chromium`

# --- Dashboard ----------------------------------------------------------------
API_INTERNAL_URL=http://127.0.0.1:8000
