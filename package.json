{
  "name": "website-to-agents",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
